{
  "name": "aegis-desktop",
  "productName": "Aegis",
  "version": "0.2.1",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Aegis contributors",
  "license": "MIT",
  "description": "Central local de segurança e privacidade",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "check": "npm run test && npm run build",
    "prepare:runtimes": "node scripts/prepare-runtimes.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:effects": "node scripts/test-ui-effects.cjs",
    "test:dpapi": "node scripts/test-dpapi.cjs",
    "check:runtimes": "node scripts/check-runtimes.cjs",
    "test:guard": "node scripts/test-windows-guard.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "playwright": "1.62.1"
  },
  "type": "module"
}
